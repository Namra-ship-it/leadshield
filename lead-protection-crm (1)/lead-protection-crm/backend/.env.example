# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Lead Guard CRM"

# Security
SECRET_KEY=super-secret-lead-protection-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL URL or default SQLite)
# For PostgreSQL: postgresql://user:password@localhost:5432/lead_crm
DATABASE_URL=sqlite:///./lead_crm.db

# Provider Adapters Selection
# Options:
# MESSAGING_PROVIDER: meta_whatsapp_cloud | telegram | mock_whatsapp (default: mock_whatsapp)
# PAYMENT_PROVIDER: stripe_test | razorpay_test | mock_checkout (default: mock_checkout)
# CALENDAR_PROVIDER: google_oauth | internal_ics (default: internal_ics)
# NOTIFY_PROVIDER: telegram | slack_webhook | smtp_email (default: telegram)
MESSAGING_PROVIDER=mock_whatsapp
PAYMENT_PROVIDER=mock_checkout
CALENDAR_PROVIDER=internal_ics
NOTIFY_PROVIDER=telegram

# 1. Meta WhatsApp Cloud API (Test Number / Production)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=leadguard_wa_verify_token_2026

# 2. Stripe Test Mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# 3. Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 4. Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback

# 5. Telegram Escalation & Team Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=leadguard_telegram_secret_2026
TELEGRAM_DEFAULT_CHAT_ID=

# 6. Slack Incoming Webhook
SLACK_WEBHOOK_URL=

# 7. SMTP Email Provider
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@leadguardcrm.com
